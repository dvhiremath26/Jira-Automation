# In GitHub: use Actions variables for JIRA_DEPLOYMENT, JIRA_BASE_URL,
# SOURCE_REPOSITORY, SOURCE_REF, HTML_REPORT_PATH and optional RUNNER_LABELS.
# RUNNER_LABELS example: ["self-hosted","linux","x64","jira-dc"]
# Store JIRA_PAT and CROSS_REPO_PAT as Actions secrets, never commit real tokens.
